<div class="card">
  <p class="muted"><a href="<%= dashboard_path %>">&larr; Back to feeds</a></p>
  <h2><%= @item.title.presence || "(untitled)" %></h2>
  <p class="muted">
    <strong><%= @item.feed&.title.presence || @item.feed&.canonical_url %></strong>
    <% if @item.author.present? %> &middot; <%= @item.author %><% end %>
    &middot; Published <%= (@item.published_at || @item.first_seen_at)&.strftime("%Y-%m-%d %H:%M UTC") %>
    &middot; Revision <%= @item.current_revision_number %>
    <% if @item.external_url.present? %>
      &middot; <a href="<%= @item.external_url %>" target="_blank" rel="noopener noreferrer">Original article</a>
    <% end %>
  </p>

  <div style="margin: 0.75rem 0; display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <% is_read = @user_item&.read? == true %>
    <% is_saved = @user_item&.saved? == true %>
    <% is_archived = @user_item&.archived? == true %>

    <%= button_to(is_read ? "Mark unread" : "Mark read",
      update_feed_item_state_path(@item, read: !is_read),
      method: :patch, class: "secondary", form: { class: "inline-form" }) %>
    <%= button_to(is_saved ? "Unsave" : "Save",
      update_feed_item_state_path(@item, saved: !is_saved),
      method: :patch, class: is_saved ? "btn" : "secondary", form: { class: "inline-form" }) %>
    <%= button_to(is_archived ? "Unarchive" : "Archive",
      update_feed_item_state_path(@item, archived: !is_archived),
      method: :patch, class: "secondary", form: { class: "inline-form" }) %>
  </div>

  <hr>
  <div>
    <% if @item.content_html_sanitized.present? %>
      <%= sanitize(@item.content_html_sanitized) %>
    <% else %>
      <%= simple_format(@item.content_text.to_s) %>
    <% end %>
  </div>
</div>
