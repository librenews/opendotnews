<div class="card">
  <p class="muted"><a href="<%= dashboard_path %>">&larr; Back to feeds</a></p>
  <h2><%= @item.title.presence || "(untitled)" %></h2>
  <p class="muted">
    <strong><%= @item.feed&.title.presence || @item.feed&.canonical_url %></strong>
    <% if @item.author.present? %> &middot; <%= @item.author %><% end %>
    &middot; Published <%= (@item.published_at || @item.first_seen_at)&.strftime("%Y-%m-%d %H:%M UTC") %>
    &middot; Revision <%= @item.current_revision_number %>
    <% if @item.external_url.present? %>
      &middot; <a href="<%= @item.external_url %>" target="_blank" rel="noopener noreferrer">Original article</a>
    <% end %>
  </p>
  <hr>
  <div>
    <% if @item.content_html_sanitized.present? %>
      <%= sanitize(@item.content_html_sanitized) %>
    <% else %>
      <%= simple_format(@item.content_text.to_s) %>
    <% end %>
  </div>
</div>
