<div class="card">
  <p class="muted"><a href="<%= documents_path %>">&larr; Back to documents</a></p>
  <h2>New Markdown Document</h2>
  <%= form_with url: documents_path, method: :post, local: true do |f| %>
    <label>Path (under <code>/<%= current_user.namespace %>/</code>, e.g. <code>notes/hello</code>)</label>
    <%= f.text_field :path, value: @document.path, required: true, placeholder: "notes/hello" %>

    <label>Title (optional; derived from frontmatter or heading if omitted)</label>
    <%= f.text_field :title, value: @document.title %>

    <label>Visibility</label>
    <%= f.select :visibility, [ [ "Draft (private)", "draft" ], [ "Public (visible on web & feeds)", "public" ] ], selected: @document.visibility %>

    <label style="display:block; margin-top:0.6rem;">Markdown</label>
    <%= f.text_area :markdown, value: @markdown, rows: 14, required: true %>

    <%= f.submit "Save Document", class: "btn" %>
  <% end %>
</div>
