<div class="card auth-box">
  <h2>Create your Open.News account</h2>
  <% if @user.errors.any? %>
    <div class="flash alert">
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: signup_path, local: true do |f| %>
    <label>Email</label>
    <%= f.email_field :email, required: true, autofocus: true %>

    <label>Namespace (immutable public handle, e.g. <code>matt</code>)</label>
    <%= f.text_field :namespace, required: true, placeholder: "matt" %>

    <label>Password</label>
    <%= f.password_field :password, required: true %>

    <label>Confirm Password</label>
    <%= f.password_field :password_confirmation, required: true %>

    <%= f.submit "Create account", class: "btn" %>
  <% end %>
  <p class="muted">Already have an account? <a href="<%= login_path %>">Sign in</a>.</p>
</div>
