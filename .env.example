# Open.News environment configuration
# Copy to .env for local development. Never commit real secrets.

APP_BASE_URL=http://localhost:3000
RAILS_ENV=development
RAILS_MAX_THREADS=5

# Database (defaults to local Homebrew PostgreSQL socket if unset)
# DATABASE_URL=postgres://localhost/opendotnews_development

# Redis (used exclusively for Sidekiq queues; not authoritative storage)
REDIS_URL=redis://127.0.0.1:6379/0

# Feed ingestion & safety limits
FEED_POLL_INTERVAL_MINUTES=15
FEED_MAX_BYTES=5242880
FEED_MAX_DECOMPRESSED_BYTES=10485760
FEED_HTTP_TIMEOUT_SECONDS=15
FEED_MAX_REDIRECTS=5

# OPML limits
OPML_MAX_BYTES=2097152
OPML_MAX_FEEDS=2000

# Durable inbox retention (days)
INBOX_RETENTION_DAYS=90

# Per-account quotas & abuse controls (Phase 5)
MAX_SUBSCRIPTIONS_PER_USER=500
MAX_DOCUMENTS_PER_USER=500
MAX_DOCUMENT_STORAGE_BYTES_PER_USER=52428800
MAX_PUBLISHES_PER_HOUR=60
MAX_DOWNSTREAM_SUBSCRIBERS_PER_PUBLICATION=500
MAX_DOWNSTREAM_FANOUT_PER_EVENT=500
ABUSE_CONTACT_EMAIL=abuse@open.news

# Operator administration & metrics (optional)
# OPERATOR_EMAILS=admin@example.com
# OPERATOR_METRICS_TOKEN=

# Production secrets (generate with `bin/rails secret`)
# SECRET_KEY_BASE=
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
